# Chép file này thành .env rồi đổi giá trị nếu muốn. Không có .env thì docker compose dùng giá trị mặc định (chỉ để chạy thử trên máy).
MYSQL_ROOT_PASSWORD=root_pw
AUTH_DB_PASSWORD=auth_user_pw
PROVIDER_DB_PASSWORD=provider_user_pw
PATIENT_DB_PASSWORD=patient_user_pw
SCHEDULING_DB_PASSWORD=scheduling_user_pw
REMINDER_DB_PASSWORD=reminder_user_pw
KEYCLOAK_DB_PASSWORD=keycloak_user_pw
RABBITMQ_USER=clinic
RABBITMQ_PASSWORD=clinic_pw
# Tài khoản quản trị Keycloak (trang http://localhost:8180/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_pw
# Mật khẩu của client auth-service trong realm; Keycloak nạp vào realm, auth-service dùng để gọi Admin API
AUTH_SERVICE_CLIENT_SECRET=doi-chuoi-nay-trong-file-env
# Chuỗi ký JWT của phương án cũ, Gateway còn đọc cho tới khi chuyển sang xác minh token Keycloak (P4-4)
JWT_SECRET=doi-chuoi-nay-trong-file-env-it-nhat-32-ky-tu!!
